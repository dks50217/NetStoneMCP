# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.1

# Discord Bot Configuration
DISCORD_BOT_KEY=your_discord_bot_token_here

# MCP Transport Mode ("SSE" for HTTP SSE, "Stdio" for standard I/O process)
TransportType=SSE
TRANSPORT_TYPE=SSE

# MCP Server Endpoint (used by client / bot in SSE mode)
NETSTONE_SSE_URL=http://localhost:5000/sse

# Optional: Path to NetStoneMCP.csproj (used by samples in Stdio mode if running outside default repo tree)
# NETSTONE_PROJECT_PATH=../../src/NetStoneMCP.csproj
